{
  "name": "agentic-a11y",
  "version": "1.0.0",
  "description": "AI-powered accessibility Chrome extension with dynamic onboarding and skill building",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "test:browser": "node test/extension-integration-test.mjs && node test/background-input-test.mjs && node test/checks-off-e2e.mjs",
    "test:live": "node test/live-runtime-test.mjs --live",
    "audit:journey": "node test/audit-live-journey.mjs --live",
    "audit:agent": "node test/audit-live-agent.mjs --live",
    "audit:actions": "node test/audit-live-actions.mjs --live",
    "audit:attention": "node test/audit-live-attention.mjs --live",
    "audit:workflows": "node test/audit-live-workflows.mjs --live",
    "test": "node test/run-verification-tests.mjs",
    "audit:copy": "node test/audit-copy-transfer.mjs --live"
  },
  "devDependencies": {
    "@ai4a11y/toolkit": "file:../vendor/ai4a11y-toolkit.tgz",
    "@ai4a11y/tools": "file:../vendor/ai4a11y-tools.tgz",
    "aria-query": "^5.3.2",
    "chokidar": "^3.6.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "puppeteer": "^24.42.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axe-core": "^4.12.1",
    "colorjs.io": "^0.7.0",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "^3.4.12",
    "tabbable": "^6.5.0"
  }
}
